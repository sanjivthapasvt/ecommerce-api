{
  "name": "backend",
  "version": "0.0.1",
  "description": "Awesome project developed with TypeORM.",
  "type": "commonjs",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/grunt": "^0.4.32",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/ms": "^2.1.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^16.18.104",
    "@types/nodemailer": "^6.4.17",
    "@types/otp-generator": "^4.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "grunt": "^1.6.1",
    "grunt-cli": "^1.5.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.5.2",
    "ts-node": "10.9.1",
    "tsconfig-paths": "^3.9.0",
    "typescript": "4.9.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.621.0",
    "@aws-sdk/s3-request-presigner": "^3.621.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/body-parser": "^1.19.5",
    "@types/express": "^4.17.21",
    "@types/qs": "^6.9.18",
    "async-mutex": "^0.5.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cookie": "^1.0.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "generate-password": "^1.7.1",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "logform": "^2.7.0",
    "morgan": "^1.10.0",
    "multer": "1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.0",
    "otp-generator": "^4.0.1",
    "pg": "^8.13.3",
    "qs": "^6.14.0",
    "react": "^18.3.1",
    "reflect-metadata": "^0.1.14",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "smtp2go-nodejs": "^0.3.5",
    "tsyringe": "^4.8.0",
    "typeorm": "^0.3.19",
    "uuid": "^11.0.3",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.2"
  },
  "scripts": {
    "start": "cd build && pm2-runtime start index.js -i 2 --name 'a5it-backend'",
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/index.ts",
    "dev:sync": "nodemon --exec ts-node src/index.ts --sync",
    "build:local": "rm -rf build && tsc && cp .env.local ./build/.env",
    "build:prod": "rm -rf build && tsc && cp .env.prod ./build/.env",
    "build:staging": "rm -rf build && tsc && cp .env.staging ./build/.env",
    "test": "jest",
    "migration:generate": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate ./src/migrations/Migration -d ./src/config/database.ts",
    "migration:create": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create",
    "migration:run": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d ./src/config/database.ts",
    "migration:revert": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d ./src/config/database.ts",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "format": "prettier --write .",
    "grunt": "grunt"
  }
}